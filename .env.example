# Copy values from here into a real .env, or set them in your hosting platform.
# The backend reads environment variables directly; it does not auto-load .env.

# --- Frontend ---
# Set window.NEUVOICE_API_URL before app.js loads (see README).
# NEUVOICE_API_URL=http://127.0.0.1:8000/transcribe

# --- Backend server ---
NEUVOICE_HOST=0.0.0.0
NEUVOICE_PORT=8000
NEUVOICE_RELOAD=true

# --- Model / inference ---
NEUVOICE_MODEL_ID=openai/whisper-small
NEUVOICE_DEFAULT_LANGUAGE=en
NEUVOICE_TRAINING_LANGUAGE=hi

# Comma-separated CORS allow-list. "*" is allowed only because no credentials are used.
NEUVOICE_ALLOWED_ORIGINS=*

# --- Training ---
NEUVOICE_TRAIN_OUTPUT_DIR=./models/whisper-finetuned
NEUVOICE_FINAL_MODEL_DIR=./models/whisper-finetuned-final
NEUVOICE_MAX_STEPS=20

# --- API limits / logging ---
NEUVOICE_MAX_UPLOAD_MB=100
NEUVOICE_LOG_LEVEL=INFO

# --- Tests ---
# Set to 1 to opt into network-dependent Hugging Face / Common Voice integration tests.
NEUVOICE_RUN_INTEGRATION=0
